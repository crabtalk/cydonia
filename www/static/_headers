# SvelteKit content-hashes everything under here, so the URL changes whenever
# the bytes do and the cache never needs to ask.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The updater's feed, which is not content-hashed: every launch that checks for
# a release asks for this same address. Fifteen minutes keeps a release visible
# the day it ships without sending each of those asks to the origin.
/changelog.json
  Cache-Control: public, max-age=900

# The demo's files are not content-hashed, so this is also how long a deploy
# can keep serving the previous build. It stops every open of the dialog
# revalidating the wasm first.
/demo/*
  Cache-Control: public, max-age=300
