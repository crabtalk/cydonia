#!/usr/bin/env bash
# What gpui links against on Linux and the runner image does not carry: fonts,
# and both display servers, since `gpui_linux` defaults to wayland + x11. The
# generic toolchain — build-essential, pkg-config, libssl-dev — is already
# there. Taken from bezel, which cydonia is built on and which needs the same
# set for the same reason.
#
# `bezel-browser` builds wry's webkit2gtk webview, which links GTK 3 and
# WebKitGTK 4.1.
set -euo pipefail
apt-get update
apt-get install -y --no-install-recommends \
    libfontconfig-dev \
    libgtk-3-dev \
    libwayland-dev \
    libwebkit2gtk-4.1-dev \
    libx11-xcb-dev \
    libxkbcommon-x11-dev
